# Configurações de API e Autenticação - JobAutomator AI

# 1. Google Gmail (OAuth2 / App Password)
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app_16_digitos
GMAIL_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=seu_client_secret

# 2. Notificações Telegram Bot
TELEGRAM_BOT_TOKEN=seu_bot_token_do_botfather
TELEGRAM_CHAT_ID=seu_chat_id_do_telegram

# 3. Modelos de IA & Supabase
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_KEY=sua_chave_anon_ou_service
